templates/
interception/
archive/
debug_captcha/


# ==========================================
# 排除圖片中出現的 Python 快取與虛擬環境
# ==========================================

# 排除 Python 自動生成的快取資料夾
__pycache__/
*.pyc

# 排除 Python 虛擬環境資料夾 (防止幾萬個套件檔案被上傳)
venv/

# ==========================================
# 其他常見的作業系統與編輯器暫存檔 (建議加入)
# ==========================================

# Windows 系統產生的縮圖快取
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS 系統產生的描述檔
.DS_Store

# IDE / 編輯器設定檔 (例如 VS Code)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
